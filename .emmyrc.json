{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "Lua5.1",
    "path": [
      "lua/?.lua",
      "lua/?/init.lua"
    ]
  },
  "workspace": {
    "workspaceRoots": [
      "lua",
      "tests"
    ],
    "library": [
      {
        "path": "/usr/share/nvim/runtime",
        "ignoreDir": [
          "syntax",
          "plugin",
          "pack",
          "ftplugin"
        ]
      },
      {
        "path": "deps/mini.nvim",
        "ignoreDir": [
          "tests",
          "benchmarks"
        ]
      }
    ],
    "ignoreDir": [
      ".git"
    ]
  },
  "diagnostics": {
    "globals": [
      "vim"
    ]
  },
  "hint": {
    "paramHint": true,
    "localHint": true
  }
}
